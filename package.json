{
  "name": "docflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "gate:hosted": "node --experimental-strip-types supabase/tests/hosted-gate.ts",
    "gate:hosted:local": "node --env-file=.env --experimental-strip-types supabase/tests/hosted-gate.ts",
    "pentest": "node --experimental-strip-types tools/pentest/run.ts",
    "discoverability": "UPDATE_DISCOVERABILITY=1 vitest run src/marketing/sheet.test.ts",
    "site": "EMIT_SITE=1 vitest run src/marketing/emit.test.ts",
    "shots:build": "vite build --config vite.shots.config.ts",
    "shots": "npm run shots:build && SHOOT=1 vitest run tools/screenshots/capture.test.ts",
    "policy": "npm run build && POLICY=1 vitest run src/marketing/policy/run.test.ts",
    "sweep:responsive": "npm run shots:build && SWEEP=1 vitest run tools/sweeps/responsive.test.ts",
    "sweep:largetext": "npm run shots:build && SWEEP=1 vitest run tools/sweeps/largetext.test.ts",
    "sweep:screenreader": "npm run shots:build && SWEEP=1 vitest run tools/sweeps/screenreader.test.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/parser": "^8.26.0",
    "@typescript-eslint/utils": "^8.26.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "fast-check": "^4.10.0",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
