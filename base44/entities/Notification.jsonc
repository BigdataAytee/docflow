{
  "name": "Notification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "payment_received",
        "payment_failed",
        "payment_pending",
        "receipt_generated"
      ],
      "title": "Type"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "document_id": {
      "type": "string",
      "title": "Document ID"
    },
    "document_number": {
      "type": "string",
      "title": "Document Number"
    },
    "payment_record_id": {
      "type": "string",
      "title": "Payment Record ID"
    },
    "is_read": {
      "type": "boolean",
      "title": "Read",
      "default": false
    },
    "amount": {
      "type": "number",
      "title": "Amount"
    },
    "currency": {
      "type": "string",
      "title": "Currency"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "target_user_id": {
      "type": "string",
      "title": "Target User ID"
    }
  },
  "required": [
    "type",
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "target_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "target_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}