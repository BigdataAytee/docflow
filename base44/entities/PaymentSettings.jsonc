{
  "name": "PaymentSettings",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "title": "Payment Provider",
      "enum": [
        "stripe",
        "paypal",
        "flutterwave",
        "paystack",
        "wise",
        "square",
        "custom"
      ],
      "default": "stripe"
    },
    "display_name": {
      "type": "string",
      "title": "Provider Display Name"
    },
    "is_enabled": {
      "type": "boolean",
      "title": "Enabled",
      "default": false
    },
    "is_default": {
      "type": "boolean",
      "title": "Default Provider",
      "default": false
    },
    "test_mode": {
      "type": "boolean",
      "title": "Test Mode",
      "default": true
    },
    "api_key": {
      "type": "string",
      "title": "API Key / Public Key"
    },
    "secret_key": {
      "type": "string",
      "title": "Secret Key"
    },
    "webhook_secret": {
      "type": "string",
      "title": "Webhook Secret"
    },
    "return_url": {
      "type": "string",
      "title": "Return URL (after payment)"
    },
    "webhook_url": {
      "type": "string",
      "title": "Webhook URL"
    },
    "supported_currencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Supported Currencies"
    },
    "supported_countries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Supported Countries"
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Payment Methods",
      "default": [
        "card"
      ]
    },
    "extra_config": {
      "type": "string",
      "title": "Extra Configuration (JSON)"
    }
  },
  "required": [
    "provider"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}