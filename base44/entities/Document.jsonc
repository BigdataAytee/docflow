{
  "name": "Document",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "invoice",
        "quotation",
        "receipt",
        "waybill"
      ],
      "title": "Document Type"
    },
    "number": {
      "type": "string",
      "title": "Document Number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "paid",
        "partially_paid",
        "overdue",
        "cancelled",
        "accepted",
        "rejected",
        "pending",
        "packed",
        "dispatched",
        "in_transit",
        "delivered",
        "returned",
        "to_be_signed",
        "to_be_delivered"
      ],
      "title": "Status",
      "default": "draft"
    },
    "template": {
      "type": "string",
      "enum": [
        "classic",
        "modern",
        "minimal",
        "bold",
        "elegant"
      ],
      "title": "Layout Template",
      "default": "classic"
    },
    "template_color": {
      "type": "string",
      "title": "Color Scheme",
      "default": "slate"
    },
    "template_font": {
      "type": "string",
      "title": "Typography Font",
      "default": ""
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email"
    },
    "customer_address": {
      "type": "string",
      "title": "Customer Address"
    },
    "logo_url": {
      "type": "string",
      "title": "Company Logo URL"
    },
    "company_name": {
      "type": "string",
      "title": "Company Name"
    },
    "company_email": {
      "type": "string",
      "title": "Company Email"
    },
    "company_phone": {
      "type": "string",
      "title": "Company Phone"
    },
    "company_address": {
      "type": "string",
      "title": "Company Address"
    },
    "company_website": {
      "type": "string",
      "title": "Company Website"
    },
    "manager_name": {
      "type": "string",
      "title": "Manager / Signatory Name"
    },
    "manager_title": {
      "type": "string",
      "title": "Manager Title / Position"
    },
    "manager_signature": {
      "type": "string",
      "title": "Manager Signature"
    },
    "customer_signature": {
      "type": "string",
      "title": "Customer Signature"
    },
    "receiver_name": {
      "type": "string",
      "title": "Receiver Full Name"
    },
    "receiver_date": {
      "type": "string",
      "title": "Date Received"
    },
    "receiver_time": {
      "type": "string",
      "title": "Time Received"
    },
    "delivery_signed_at": {
      "type": "string",
      "title": "Delivery Signed At"
    },
    "delivery_proof_url": {
      "type": "string",
      "title": "Delivery Proof Image URL"
    },
    "terms_label": {
      "type": "string",
      "title": "Terms Label",
      "default": "Due on Receipt"
    },
    "items": {
      "type": "array",
      "title": "Line Items",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "discount": {
            "type": "number",
            "default": 0
          },
          "amount": {
            "type": "number"
          },
          "image_url": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "global_discount_rate": {
      "type": "number",
      "default": 0,
      "title": "Global Discount %"
    },
    "global_discount_amount": {
      "type": "number",
      "default": 0,
      "title": "Global Discount Amount"
    },
    "discount_total": {
      "type": "number",
      "default": 0
    },
    "shipping": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "balance_due": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "issue_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "terms": {
      "type": "string"
    },
    "payment_instructions": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Cash",
        "Bank Transfer",
        "POS",
        "Credit Card",
        "Mobile Money",
        "Cheque"
      ],
      "title": "Payment Method"
    },
    "bank_name": {
      "type": "string",
      "title": "Bank Name"
    },
    "account_number": {
      "type": "string",
      "title": "Account Number"
    },
    "account_holder_name": {
      "type": "string",
      "title": "Account Holder Name"
    },
    "transaction_id": {
      "type": "string",
      "title": "Transaction ID"
    },
    "reference_number": {
      "type": "string",
      "title": "Reference Number"
    },
    "driver_name": {
      "type": "string",
      "title": "Driver Name"
    },
    "vehicle_number": {
      "type": "string",
      "title": "Vehicle Number"
    },
    "tracking_number": {
      "type": "string",
      "title": "Tracking Number"
    }
  },
  "required": [
    "type",
    "number",
    "customer_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}