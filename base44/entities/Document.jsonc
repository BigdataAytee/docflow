{
  "name": "Document",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "invoice",
        "quotation",
        "receipt",
        "waybill",
        "delivery_note",
        "purchase_order",
        "credit_note",
        "letterhead"
      ],
      "title": "Document Type"
    },
    "number": {
      "type": "string",
      "title": "Document Number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled",
        "accepted",
        "rejected"
      ],
      "title": "Status",
      "default": "draft"
    },
    "template": {
      "type": "string",
      "enum": [
        "classic",
        "modern",
        "minimal",
        "bold",
        "elegant"
      ],
      "title": "Template",
      "default": "classic"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email"
    },
    "customer_address": {
      "type": "string",
      "title": "Customer Address"
    },
    "logo_url": {
      "type": "string",
      "title": "Company Logo URL"
    },
    "company_name": {
      "type": "string",
      "title": "Company Name"
    },
    "company_email": {
      "type": "string",
      "title": "Company Email"
    },
    "company_phone": {
      "type": "string",
      "title": "Company Phone"
    },
    "company_address": {
      "type": "string",
      "title": "Company Address"
    },
    "company_website": {
      "type": "string",
      "title": "Company Website"
    },
    "manager_signature": {
      "type": "string",
      "title": "Manager Signature"
    },
    "customer_signature": {
      "type": "string",
      "title": "Customer Signature"
    },
    "terms_label": {
      "type": "string",
      "title": "Terms Label",
      "default": "Due on Receipt"
    },
    "items": {
      "type": "array",
      "title": "Line Items",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "discount": {
            "type": "number",
            "default": 0
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "discount_total": {
      "type": "number",
      "default": 0
    },
    "shipping": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "default": 0
    },
    "balance_due": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "issue_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "terms": {
      "type": "string"
    },
    "payment_instructions": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "number",
    "customer_name"
  ]
}