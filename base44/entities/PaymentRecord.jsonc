{
  "name": "PaymentRecord",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "title": "Document ID"
    },
    "document_number": {
      "type": "string",
      "title": "Document Number"
    },
    "document_type": {
      "type": "string",
      "title": "Document Type"
    },
    "payment_status": {
      "type": "string",
      "title": "Payment Status",
      "enum": [
        "unpaid",
        "pending",
        "paid",
        "failed",
        "partially_paid"
      ],
      "default": "unpaid"
    },
    "payment_provider": {
      "type": "string",
      "title": "Payment Provider"
    },
    "payment_link": {
      "type": "string",
      "title": "Payment Link"
    },
    "payment_reference": {
      "type": "string",
      "title": "Payment Reference"
    },
    "transaction_id": {
      "type": "string",
      "title": "Transaction ID"
    },
    "payment_date": {
      "type": "string",
      "title": "Payment Date"
    },
    "amount_due": {
      "type": "number",
      "title": "Amount Due",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "title": "Amount Paid",
      "default": 0
    },
    "currency": {
      "type": "string",
      "title": "Currency"
    },
    "payment_method": {
      "type": "string",
      "title": "Payment Method"
    },
    "payment_notes": {
      "type": "string",
      "title": "Payment Notes"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email"
    },
    "receipt_id": {
      "type": "string",
      "title": "Generated Receipt ID"
    },
    "receipt_number": {
      "type": "string",
      "title": "Receipt Number"
    },
    "webhook_payload": {
      "type": "string",
      "title": "Raw Webhook Payload"
    },
    "is_test": {
      "type": "boolean",
      "title": "Test Payment",
      "default": false
    }
  },
  "required": [
    "document_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}