{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "composite": true,
    // `npm run pentest` runs run.ts through node's type stripping, which does
    // no module resolution of its own: node needs the real filename on disk.
    // Permitted, not required — every other file here is resolved by vitest
    // and stays extensionless.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
    // The RLS project also typechecks the row mappers and what they depend on,
  // so `supabase/tests/rows.test.ts` is checked rather than merely run. Listed
  // as FILES, not directories: `src/features/credits` as a directory would
  // drag in a React component and its test, and this project has no DOM lib.
  "include": [
    "vite.config.ts",
    "vitest.rls.config.ts",
    "vitest.setup.ts",
    "eslint.config.js",
    "tools",
    "supabase/tests",
    "src/data/repositories",
    "src/data/supabase/rows.ts",
    "src/domain",
    "src/share/events.ts",
    "src/share/port.ts",
    "src/features/credits/issue.ts",
    "src/features/documents/reference.ts"
  ],
  "exclude": ["legacy"]
}
