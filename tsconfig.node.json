{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "composite": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "vitest.rls.config.ts", "vitest.setup.ts", "eslint.config.js", "tools", "supabase/tests"],
  "exclude": ["legacy"]
}
